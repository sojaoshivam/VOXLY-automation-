# ── Database ────────────────────────────────────────────────
# MUST be the SAME Neon Postgres connection string used by voxly-v2-local.
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# ── App auth (NextAuth / Google sign-in) ────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# ── Google / YouTube ────────────────────────────────────────
# Used for BOTH app login and YouTube publishing.
# In Google Cloud Console add these Authorized redirect URIs:
#   http://localhost:3001/api/auth/callback/google   (app login)
#   http://localhost:3001/api/auth/youtube/callback   (YouTube connect)
# and enable "YouTube Data API v3".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback

# ── Facebook / Instagram ────────────────────────────────────
# Requires an Instagram Business/Creator account linked to a Facebook Page,
# with instagram_content_publish permission on the Meta app.
# Add this redirect URI as a Valid OAuth Redirect URI in the Meta app:
#   http://localhost:3001/api/auth/instagram/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/auth/instagram/callback

# ── Secrets ─────────────────────────────────────────────────
# 32-byte hex key for encrypting stored OAuth tokens. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Protects the Vercel cron endpoint. Generate: openssl rand -hex 32
CRON_SECRET=

# ── AI (OpenRouter) ─────────────────────────────────────────
# Used for auto-generating titles, captions, and tags.
OPENROUTER_API_KEY=

# ── Cloudflare R2 (optional, for cloud video deletion) ──────
# Same credentials as voxly-v2-local. If unset, delete only removes DB records.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
